# Optional. Copy to .env.local (never commit real secrets).
# AI lesson summaries use a small open model you run yourself; nothing is paid and no key is needed.
# Example with Ollama: `ollama pull qwen2.5:3b`, then set:
ROVA_LLM_URL=
#   ROVA_LLM_URL=http://localhost:11434/v1
# Optional model name (default: qwen2.5:3b). Any model your local server has pulled works.
ROVA_LLM_MODEL=
# Optional: a separate data directory for an isolated rehearsal.
ROVA_DATA_DIR=
