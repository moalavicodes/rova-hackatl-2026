# Optional. Copy to .env.local (never commit real keys).
# With a key, teachers can request an AI-written lesson summary; without one, the scripted summary is used.
ANTHROPIC_API_KEY=
# Optional model override for lesson summaries (default: claude-opus-5-5).
ROVA_SUMMARY_MODEL=
# Optional: a separate data directory for an isolated rehearsal.
ROVA_DATA_DIR=
